rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - authenticated users can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow creating own profile during signup
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Sub-collections under each user
      match /guardians/{guardianId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /emergency_alerts/{alertId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /user_locations/{locationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Helplines - any authenticated user can read, only admins can write
    match /helplines/{helplineId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Police stations - any authenticated user can read, only admins can write
    match /police_stations/{stationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Alert feed - collection group query support
    // Allows reading emergency_alerts across all users (for admin/police dashboards)
    match /{path=**}/emergency_alerts/{alertId} {
      allow read: if request.auth != null;
    }
  }
}
