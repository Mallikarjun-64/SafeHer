# SafeHer SOS Alert System - Environment Variables
# Copy this file to .env and fill in your actual API keys

# Twilio SMS Configuration
REACT_APP_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
REACT_APP_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
REACT_APP_TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Email Service Configuration (EmailJS)
REACT_APP_EMAIL_API_KEY=your_emailjs_public_key_here
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
REACT_APP_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# Email Configuration
REACT_APP_SENDER_EMAIL=alerts@safeher.com
REACT_APP_SENDER_NAME=SafeHer Emergency System

# Note: For development/testing, you can leave these empty to use demo mode
# The system will simulate SMS and Email sending when API keys are not configured
